<div class="navbar bg-primary text-white shadow-lg px-4">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost text-xl">
        <img src="/images/logo.png" alt="Flag" class="w-6 h-4 mr-2">
        National Historic Sites
      </a>
    </div>
    <div class="flex-none gap-4">
      <a href="/sites" class="btn btn-ghost hover:bg-primary hover:text-white <%= (page === '/sites') ? 'active' : '' %>">View Site Collection</a>
      <a href="/about" class="btn btn-ghost hover:bg-primary hover:text-white <%= (page === '/about') ? 'active' : '' %>">About</a>
      <a href="/" class="btn btn-ghost hover:bg-primary hover:text-white <%= (page === '/') ? 'active' : '' %>">Home</a>
  
      <% if (session.user) { %>
        <li class="dropdown dropdown-end list-none">
          <details class="dropdown">
            <summary class="btn btn-ghost">Account: <%= session.user.userName %></summary>
            <ul class="p-2 menu dropdown-content z-[1] bg-base-100 text-black rounded-box w-52">
              <li><a class="<%= (page == '/addSite') ? 'active' : '' %>" href="/addSite">Add Site</a></li>
              <li><a class="<%= (page == '/userHistory') ? 'active' : '' %>" href="/userHistory">User History</a></li>
              <li><a href="/logout">Log Out</a></li>
            </ul>
          </details>
        </li>
      <% } else { %>
        <li class="dropdown dropdown-end list-none">
          <details class="dropdown">
            <summary class="btn btn-ghost">Account</summary>
            <ul class="p-2 menu dropdown-content z-[1] bg-base-100 text-black rounded-box w-52">
              <li><a class="<%= (page == '/login') ? 'active' : '' %>" href="/login">Login</a></li>
              <li><a class="<%= (page == '/register') ? 'active' : '' %>" href="/register">Register</a></li>
            </ul>
          </details>
        </li>
      <% } %>
    </div>
  </div>
  